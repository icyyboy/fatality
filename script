                            var range = Math.min(300, (wep && wep.maxRange)||300);
                            var x1=x+dx*range, y1=y+dy*range, z1=z+dz*range;
                            try { if (G.physics && typeof G.physics.raycast==='function') { var hit=G.physics.raycast(x,y,z,dx,dy,dz,range,2); if(hit&&typeof hit.t==='number'){x1=x+dx*hit.t;y1=y+dy*hit.t;z1=z+dz*hit.t;} } } catch(_) {}
                            var col = (!shooter||shooter.isPlayer)?'#ffeb3b':(G.player&&shooter.team===G.player.team?'#69f0ae':'#ff5252');
                            addTracer(x+dx*0.35, y+dy*0.35, z+dz*0.35, x1, y1, z1, col);
                        }
                    } catch(_) {}
                    return result;
                };
            }
        } catch(e) {}
        try {
            if (typeof G.playerShoot === 'function') {
                orig.playerShoot = G.playerShoot.bind(G);
                G.playerShoot = function(wep, sx, sy) {
                    if (!isFeatureActive('silent_aim') || !orig.fireBullet) return orig.playerShoot(wep, sx, sy);
                    var target = pickSilentTarget();
                    if (!target) return orig.playerShoot(wep, sx, sy);
                    var p=player(), o=eyeOf(p), t=target.t;
                    var dx=t.x-o.x, dy=t.y-o.y, dz=t.z-o.z, len=Math.hypot(dx,dy,dz)||1;
                    dx/=len; dy/=len; dz/=len;
                    if (CFG.silent_aim_smooth>0) {
                        var pitch=(p.pitch||0), yaw=p.yaw, co=Math.cos(pitch);
                        var rx=-Math.sin(yaw)*co, ry=Math.sin(pitch), rz=-Math.cos(yaw)*co;
                        var s=CFG.silent_aim_smooth;
                        dx=dx*(1-s)+rx*s; dy=dy*(1-s)+ry*s; dz=dz*(1-s)+rz*s;
                        var L=Math.hypot(dx,dy,dz)||1; dx/=L; dy/=L; dz/=L;
                    }
                    return orig.fireBullet(p, o.x, o.y, o.z, dx, dy, dz, wep);
                };
            }
        } catch(e) {}
        hooked = true;
    }

    function pickSilentTarget() {
        var p = player(); if (!p||!p.alive) return null;
        var o = eyeOf(p), maxFov=(CFG.silent_aim_fov||25)*Math.PI/180;
        var best=null, bestScore=1e9, list=enemies();
        for (var i=0;i<list.length;i++) {
            var e=list[i];
            var t = {x:e.x, y:baseYOf(e)+1.55, z:e.z};
            try { if (e.cs2Agent&&e.cs2Agent.bones) { var hb=e.cs2Agent.bones.head_0||e.cs2Agent.bones.head; if(hb&&hb.getWorldPosition){var v=G.camera.position.clone();hb.getWorldPosition(v);t={x:v.x,y:v.y,z:v.z};} } } catch(_) {}
            var dx=t.x-o.x, dy=t.y-o.y, dz=t.z-o.z, dist=Math.hypot(dx,dy,dz);
            if (dist>80||dist<0.4) continue;
            var wantYaw=Math.atan2(-dx,-dz), horiz=Math.hypot(dx,dz)||0.001, wantPitch=Math.atan2(dy,horiz);
            var dYaw=wrapPi(wantYaw-p.yaw), dPitch=wantPitch-(p.pitch||0), fov=Math.hypot(dYaw,dPitch);
            if (fov>maxFov) continue;
            if (!visClear(o.x,o.y,o.z,t.x,t.y,t.z)) continue;
            var score=fov*40+dist*0.05;
            if (score<bestScore) { bestScore=score; best={ent:e,t}; }
        }
        return best;
    }

