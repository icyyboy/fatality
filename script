                if (ent && ent.isPlayer && isFeatureActive('godmode')) return orig.killEntity(ent, atk, a2, a3, a4, a5);
                var result = orig.killEntity(ent, atk, a2, a3, a4, a5);
                try { if (CFG.killfx && ent && atk && (atk === G.player || atk.isPlayer)) kfxSchedule(ent.x, (ent._visY != null ? ent._visY : ent.y)||0, ent.z); } catch(_) {}
                try { if (CFG.fun_confetti && ent && atk && (atk === G.player || atk.isPlayer)) funSpawnConfetti(ent.x, (ent._visY != null ? ent._visY : ent.y)||0, ent.z); } catch(_) {}
