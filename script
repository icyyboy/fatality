    // ============ VIEWMODEL TINT ============
    let vmTintHooked = false;
    function walkObj(obj, fn) {
        if (!obj) return; fn(obj);
        const kids = obj.children;
        if (kids && kids.length) for (let i = 0; i < kids.length; i++) walkObj(kids[i], fn);
    }
    function applyVmMat(m) {
        if (!m) return;
        if (m.userData._vmOrigColor == null && m.color) {
            m.userData._vmOrigColor = m.color.clone();
            m.userData._vmOrigOpacity = m.opacity;
        }
        if (CFG.vm_tint) {
            if (m.color && m.userData._vmOrigColor) {
                const t = CFG.vm_tint_strength, c = hexToRgbObj(CFG.vm_color);
                m.color.copy(m.userData._vmOrigColor);
                m.color.r = m.color.r*(1-t) + c.r*t;
                m.color.g = m.color.g*(1-t) + c.g*t;
                m.color.b = m.color.b*(1-t) + c.b*t;
            }
            m.transparent = true; m.opacity = CFG.vm_opacity;
            m.depthWrite = CFG.vm_opacity >= 0.99; m.needsUpdate = true;
        } else if (m.userData._vmOrigColor) {
            m.color.copy(m.userData._vmOrigColor);
            m.opacity = m.userData._vmOrigOpacity;
            m.transparent = false; m.depthWrite = true; m.needsUpdate = true;
        }
    }
    function applyVmStyle(root) {
