    // ============ INTRO ============
    let introDone=false;
    function playIntro(){
        const intro=document.getElementById('fatality-intro'),textEl=document.getElementById('fatality-text');
        textEl.innerHTML='';
        for(let i=0;i<'FATALITY'.length;i++){const span=document.createElement('span');span.className='letter';span.textContent='FATALITY'[i];span.style.animation=`reveal 0.6s cubic-bezier(0.34,1.56,0.64,1) ${i*0.12}s forwards`;textEl.appendChild(span);}
        setTimeout(()=>{intro.classList.add('hidden');introDone=true;openMenu();startParticles();},3200);
    }
    function startParticles(){
        const container=document.getElementById('particles-container');
        function createParticle(){if(!CFG.particles)return;if(!menuEl||!menuEl.classList.contains('active'))return;const particle=document.createElement('div');particle.className='particle';particle.style.left=Math.random()*window.innerWidth+'px';particle.style.top='-10px';const duration=8+Math.random()*4;particle.style.animation=`fall ${duration}s linear forwards`;container.appendChild(particle);setTimeout(()=>particle.remove(),duration*1000);}
        setInterval(createParticle,200);
    }

    function togRow(id,checked,labelText,gear,badge){
        const badgeHtml = badge ? `<span class="fx-tag fx-tag-${badge}">${badge}</span>` : '';
        return `<div class="fx-row"><label class="fx-switch"><input type="checkbox" id="${id}" ${checked?'checked':''}><span class="fx-switch-track"></span></label><label for="${id}" class="fx-label">${labelText}${badgeHtml}</label>${gear?`<span class="fx-gear ${getFeatureMode(id).mode!=='always'?'has-mode':''}" data-gear="${id}" title="Modo de activación">&#9881;</span>`:''}</div>`;
    }
    function sliderRow(id,label,min,max,step,value,suffix){suffix=suffix||'';return `<div class="fx-slider-row"><div class="fx-slider-label"><span>${label}</span><span class="fx-slider-value" id="${id}-val">${value}${suffix}</span></div><input type="range" id="${id}" class="fx-slider" min="${min}" max="${max}" step="${step}" value="${value}"></div>`;}

