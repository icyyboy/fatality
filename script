// ==UserScript==
// @name         FATALITY - Premium Cheat Menu
// @namespace    fatality.cheats.local
// @version      8.4.1
// @description  Skinchanger en grid de tarjetas, botón "Dar todas las skins", scrollbars custom. Para Clutcher.io
// @match        https://clutcher.io/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    // ============ CONFIG STORAGE ============
    const CONFIG_KEY = 'fatality_config_v8';
    const DEFAULT_CONFIG = {
        aimbot: false,
        aimbot_fov: 25,
        fov_visible: false,
        aimbot_smooth: 4,
        aimbot_autofire: false,
        aimbot_visibleOnly: true,
        aimbot_target: 'head',

        ragebot_triggerbot: false,
        triggerbot_delay: 10,

        ragebot_damage_enabled: false,
        ragebot_damage: 10,
        ragebot_onetap: false,
        ragebot_rapid: false,
        ragebot_norecoil: false,
        ragebot_nospread: false,
        ragebot_aim: false,
        infammo: false,

        esp: false,
        esp_boxes: true,
        esp_health: true,
        esp_names: true,
        esp_chams: false,
        esp_headdot: false,
        esp_skeleton: false,
        esp_visible_color: '#3cff5a',
        esp_hidden_color: '#ff4444',

        hitmarker: false,
        hitsound: false,

        godmode: false,
        armor: false,
        antiflash: false,
        infmoney: false,
        speed: 1,
        bhop: false,
        jumppower: false,
        jumppower_mult: 1.5,
        thirdperson: false,
        thirdperson_distance: 4,
        ambient_color: false,
        ambient_color_value: '#ffffff',
        ambient_intensity: 2,

        particles: true,
        menu_color: '#ffffff',
        menu_scale: 100,
        menu_key: 'Insert',

        modes: {},
        skinOpts: {}
    };

    let CFG = { ...DEFAULT_CONFIG };
    function saveCfg() {
        try { localStorage.setItem(CONFIG_KEY, JSON.stringify(CFG)); } catch (e) { }
    }
    function loadCfg() {
        try {
            const saved = localStorage.getItem(CONFIG_KEY);
            if (saved) CFG = { ...DEFAULT_CONFIG, ...JSON.parse(saved) };
            if (!CFG.modes) CFG.modes = {};
            if (!CFG.skinOpts) CFG.skinOpts = {};
        } catch (e) { }
    }
    loadCfg();

    // ============ COLOR HELPERS ============
    function hexToRgbTriplet(hex) {
        try {
            hex = hex.replace('#', '');
            if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');
            const r = parseInt(hex.slice(0, 2), 16), g = parseInt(hex.slice(2, 4), 16), b = parseInt(hex.slice(4, 6), 16);
            return `${r}, ${g}, ${b}`;
        } catch (e) { return '255, 255, 255'; }
    }
    function hexToRgba(hex, a) { return `rgba(${hexToRgbTriplet(hex)}, ${a})`; }
    function applyThemeColor(hex) {
        document.documentElement.style.setProperty('--fx-accent', hex);
        document.documentElement.style.setProperty('--fx-accent-rgb', hexToRgbTriplet(hex));
    }
    function applyMenuScale(pct) {
        document.documentElement.style.setProperty('--fx-scale', (pct || 100) / 100);
    }

    // ============ ACTIVATION SYSTEM ============
    const heldKeys = new Set();
    const toggleStates = {};

    function getFeatureMode(id) {
        if (!CFG.modes) CFG.modes = {};
        if (!CFG.modes[id]) CFG.modes[id] = { mode: 'always', key: null };
        return CFG.modes[id];
    }

    function keyLabel(code) {
        if (!code) return 'Sin asignar';
        if (code === 'Mouse0') return 'Mouse Left';
        if (code === 'Mouse1') return 'Mouse Middle';
        if (code === 'Mouse2') return 'Mouse Right';
        if (code === 'Mouse3') return 'Mouse 4 (Back)';
        if (code === 'Mouse4') return 'Mouse 5 (Fwd)';
        if (code.startsWith('Key')) return code.slice(3);
        if (code.startsWith('Digit')) return code.slice(5);
        return code;
    }

    function isFeatureActive(id) {
        if (!CFG[id]) return false;
        const m = getFeatureMode(id);
        if (m.mode === 'always') return true;
        if (!m.key) return false;
        if (m.mode === 'toggle') return !!toggleStates[id];
        return heldKeys.has(m.key);
    }

    function handleBindEdge(code) {
        if (!CFG.modes) return;
        Object.keys(CFG.modes).forEach(id => {
            const m = CFG.modes[id];
            if (m.mode === 'toggle' && m.key === code) toggleStates[id] = !toggleStates[id];
        });
    }

    document.addEventListener('keydown', (e) => { if (!e.repeat) handleBindEdge(e.code); heldKeys.add(e.code); }, true);
    document.addEventListener('keyup', (e) => { heldKeys.delete(e.code); }, true);
    document.addEventListener('mousedown', (e) => { const code = 'Mouse' + e.button; handleBindEdge(code); heldKeys.add(code); });
    document.addEventListener('mouseup', (e) => { heldKeys.delete('Mouse' + e.button); });
    document.addEventListener('contextmenu', (e) => {
        const usesRight = Object.values(CFG.modes || {}).some(m => m.key === 'Mouse2' && m.mode !== 'always');
        if (usesRight) e.preventDefault();
    });

    // ============ GAME REFERENCES ============
    let G = null, hooked = false, orig = {}, lockTarget = null, bhopActive = false, wasOnGround = true;

    function player() { return (G && G.player) || null; }
    function weapons() { return (G && G.weapons) || null; }
    function playing() { var P = player(); return !!(G && G.state === 'playing' && P && P.alive); }
    function eyeOf(e) { return { x: e.x, y: e.y + (e.eyeH || 1.6) - (e._stepLift || 0), z: e.z }; }
    function baseYOf(e) { return (e._visY == null ? e.y : e._visY); }
    function aimPointOf(e) {
        var b = baseYOf(e);
        return CFG.aimbot_target === 'head' ? { x: e.x, y: b + 1.55, z: e.z } : { x: e.x, y: b + 0.95, z: e.z };
    }
    function enemies() {
        var P = player(), out = [];
        if (!G || !P || !G.allEntities) return out;
        var list; try { list = G.allEntities(); } catch (e) { return out; }
        for (var i = 0; i < list.length; i++) {
            var e = list[i];
            if (!e || e === P || !e.alive) continue;
            if (!e.team || e.team === P.team) continue;
            if ((e.spawnProt || 0) > 0) continue;
            out.push(e);
        }
        return out;
    }
    function viewDir(yaw, pitch) { var o = Math.cos(pitch); return { x: -Math.sin(yaw) * o, y: Math.sin(pitch), z: -Math.cos(yaw) * o }; }
    function wantAngles(from, to) {
        var dx = to.x - from.x, dy = to.y - from.y, dz = to.z - from.z;
        var len = Math.sqrt(dx * dx + dy * dy + dz * dz) || 0.0001;
        return { yaw: Math.atan2(-dx, -dz), pitch: Math.asin(Math.max(-1, Math.min(1, dy / len))), dist: len };
    }
    function wrapPi(a) { while (a > Math.PI) a -= Math.PI * 2; while (a < -Math.PI) a += Math.PI * 2; return a; }
    function visClear(x1, y1, z1, x2, y2, z2) { try { return !!G.physics.lineClear(x1, y1, z1, x2, y2, z2); } catch (e) { return true; } }

    // ============ HIT MARKER / HIT SOUND ============
    let hitMarkerUntil = 0, hitMarkerIsKill = false, audioCtx = null;

    function playHitSound(isKill) {
        try {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            var o = audioCtx.createOscillator(), g = audioCtx.createGain();
            o.type = 'square'; o.frequency.value = isKill ? 1300 : 850; g.gain.value = 0.18;
            o.connect(g); g.connect(audioCtx.destination);
            var t = audioCtx.currentTime;
            g.gain.setValueAtTime(0.18, t); g.gain.exponentialRampToValueAtTime(0.001, t + 0.09);
            o.start(t); o.stop(t + 0.1);
            if (isKill) {
                var o2 = audioCtx.createOscillator(), g2 = audioCtx.createGain();
                o2.type = 'square'; o2.frequency.value = 1700; g2.gain.value = 0.15;
                o2.connect(g2); g2.connect(audioCtx.destination);
                o2.start(t + 0.07); g2.gain.setValueAtTime(0.15, t + 0.07);
                g2.gain.exponentialRampToValueAtTime(0.001, t + 0.16); o2.stop(t + 0.17);
            }
        } catch (e) { }
    }

    function triggerHitFeedback(isKill) {
        if (CFG.hitmarker) { hitMarkerUntil = performance.now() + (isKill ? 260 : 150); hitMarkerIsKill = isKill; }
        if (CFG.hitsound) playHitSound(isKill);
    }

    function drawHitMarker() {
        if (performance.now() > hitMarkerUntil) return;
        var cx = espCanvas.width / 2, cy = espCanvas.height / 2, s = hitMarkerIsKill ? 11 : 7, gap = 4;
        espCtx.strokeStyle = hitMarkerIsKill ? '#ff3b3b' : '#ffffff'; espCtx.lineWidth = 2;
        espCtx.beginPath();
        espCtx.moveTo(cx - s - gap, cy - s - gap); espCtx.lineTo(cx - gap, cy - gap);
        espCtx.moveTo(cx + gap, cy + gap); espCtx.lineTo(cx + s + gap, cy + s + gap);
        espCtx.moveTo(cx + s + gap, cy - s - gap); espCtx.lineTo(cx + gap, cy - gap);
        espCtx.moveTo(cx - gap, cy + gap); espCtx.lineTo(cx - s - gap, cy + s + gap);
        espCtx.stroke();
    }

    // ============ HOOKS ============
    function installHooks() {
        if (hooked || !G) return;
        try {
            orig.dealDamage = G.dealDamage.bind(G);
            G.dealDamage = function (vic, dmg, atk, hs, def, region, group, x8) {
                try {
                    if (vic && vic.isPlayer && isFeatureActive('godmode')) return;
                    if (atk && atk.isPlayer && vic && vic !== atk) {
                        if (isFeatureActive('ragebot_onetap')) dmg = 100000;
                        else if (isFeatureActive('ragebot_damage_enabled') && CFG.ragebot_damage !== 1) dmg = dmg * CFG.ragebot_damage;
                    }
                } catch (e) { }
                var result = orig.dealDamage(vic, dmg, atk, hs, def, region, group, x8);
                try {
                    var P = player();
                    if (atk && P && atk === P && vic && vic !== atk) {
                        var isKill = !!(vic.alive === false || (vic.health !== undefined && vic.health <= 0));
                        triggerHitFeedback(isKill);
                    }
                } catch (e) { }
                return result;
            };
        } catch (e) { }
        try {
            orig.damagePlayer = G.damagePlayer.bind(G);
            G.damagePlayer = function (amount, atk, a2, type) { if (isFeatureActive('godmode')) return; return orig.damagePlayer(amount, atk, a2, type); };
        } catch (e) { }
        try {
            orig.killEntity = G.killEntity.bind(G);
            G.killEntity = function (ent, atk, a2, a3, a4, a5) { if (ent && ent.isPlayer && isFeatureActive('godmode')) return; return orig.killEntity(ent, atk, a2, a3, a4, a5); };
        } catch (e) { }
        hooked = true;
    }

    function ensureSpeedHook() {
        try {
            var W = weapons();
            if (W && typeof W.maxSpeed === 'function' && !W.__fatalitySpd) {
                var origMaxSpeed = W.maxSpeed.bind(W);
                W.__fatalitySpd = true;
                W.maxSpeed = function () { var v = origMaxSpeed(); return (CFG.speed && CFG.speed !== 1) ? v * CFG.speed : v; };
            }
        } catch (e) { }
    }

    function ensureSpreadHook() {
        [weapons(), player()].forEach(function (obj) {
            try {
                if (!obj || obj.__fatalitySpread) return;
                var hasC = typeof obj.crosshairSpread === 'function', hasR = typeof obj.restingSpread === 'function';
                if (!hasC && !hasR) return;
                obj.__fatalitySpread = true;
                if (hasC) { var oc = obj.crosshairSpread.bind(obj); obj.crosshairSpread = function () { return isFeatureActive('ragebot_nospread') ? 0 : oc.apply(obj, arguments); }; }
                if (hasR) { var or = obj.restingSpread.bind(obj); obj.restingSpread = function () { return isFeatureActive('ragebot_nospread') ? 0 : or.apply(obj, arguments); }; }
            } catch (e) { }
        });
    }

    // ============ AIMBOT ============
    function aimTick() {
        var P = player(), W = weapons(); lockTarget = null;
        if (!isFeatureActive('aimbot') || !playing()) return;
        try { if (W) { W.punchP = 0; W.punchY = 0; } } catch (e) { }
        var eye = eyeOf(P), vd = viewDir(P.yaw, P.pitch), best = null, bestAng = (CFG.aimbot_fov || 25) * Math.PI / 180, list = enemies();
        for (var i = 0; i < list.length; i++) {
            var e = list[i], pt = aimPointOf(e);
            if (CFG.aimbot_visibleOnly && !visClear(eye.x, eye.y, eye.z, pt.x, pt.y, pt.z)) continue;
            var w = wantAngles(eye, pt), d = viewDir(w.yaw, w.pitch);
            var dot = Math.max(-1, Math.min(1, vd.x * d.x + vd.y * d.y + vd.z * d.z)), ang = Math.acos(dot);
            if (ang < bestAng) { bestAng = ang; best = { ent: e, want: w }; }
        }
        if (best) {
            lockTarget = best.ent;
            var k = 1 / Math.max(1, CFG.aimbot_smooth || 1);
            P.yaw = P.yaw + wrapPi(best.want.yaw - P.yaw) * k;
            P.pitch = P.pitch + wrapPi(best.want.pitch - P.pitch) * k;
            if (isFeatureActive('aimbot_autofire') && G.input) {
                try {
                    var vis = visClear(eye.x, eye.y, eye.z, aimPointOf(best.ent).x, aimPointOf(best.ent).y, aimPointOf(best.ent).z);
                    if (!CFG.aimbot_visibleOnly || vis) { G.input.mouse1 = true; G.input.mouse1Pressed = true; }
                    else { G.input.mouse1 = false; G.input.mouse1Pressed = false; }
                } catch (e) { }
            }
        } else if (isFeatureActive('aimbot_autofire') && G.input) {
            try { G.input.mouse1 = false; G.input.mouse1Pressed = false; } catch (e) { }
        }
    }

    // ============ RAGE AIM ============
    function rageAimTick() {
        var P = player(), W = weapons();
        if (!isFeatureActive('ragebot_aim') || !playing()) return;
        try { if (W) { W.punchP = 0; W.punchY = 0; } } catch (e) { }
        var eye = eyeOf(P), vd = viewDir(P.yaw, P.pitch), best = null, bestAng = Math.PI, list = enemies();
        for (var i = 0; i < list.length; i++) {
            var e = list[i], pt = aimPointOf(e);
            if (CFG.aimbot_visibleOnly && !visClear(eye.x, eye.y, eye.z, pt.x, pt.y, pt.z)) continue;
            var w = wantAngles(eye, pt), d = viewDir(w.yaw, w.pitch);
            var dot = Math.max(-1, Math.min(1, vd.x * d.x + vd.y * d.y + vd.z * d.z)), ang = Math.acos(dot);
            if (ang < bestAng) { bestAng = ang; best = { ent: e, want: w }; }
        }
        if (best) {
            lockTarget = best.ent; P.yaw = best.want.yaw; P.pitch = best.want.pitch;
            if (isFeatureActive('aimbot_autofire') && G.input) { try { G.input.mouse1 = true; G.input.mouse1Pressed = true; } catch (e) { } }
        }
    }

    // ============ TRIGGERBOT ============
    let triggerTimer = null;
    function triggerTick() {
        if (!isFeatureActive('ragebot_triggerbot') || !playing() || !G.input) return;
        var P = player(), eye = eyeOf(P), vd = viewDir(P.yaw, P.pitch), list = enemies(), onTarget = false;
        for (var i = 0; i < list.length; i++) {
            var e = list[i], pt = aimPointOf(e), w = wantAngles(eye, pt), d = viewDir(w.yaw, w.pitch);
            var dot = Math.max(-1, Math.min(1, vd.x * d.x + vd.y * d.y + vd.z * d.z)), ang = Math.acos(dot) * 180 / Math.PI;
            if (ang < 3 && visClear(eye.x, eye.y, eye.z, pt.x, pt.y, pt.z)) { onTarget = true; break; }
        }
        if (onTarget && !triggerTimer) {
            triggerTimer = setTimeout(function () {
                try { G.input.mouse1 = true; G.input.mouse1Pressed = true; } catch (e) { }
                setTimeout(function () { try { G.input.mouse1 = false; G.input.mouse1Pressed = false; } catch (e) { } }, 60);
                triggerTimer = null;
            }, CFG.triggerbot_delay || 0);
        } else if (!onTarget && triggerTimer) { clearTimeout(triggerTimer); triggerTimer = null; }
    }

    // ============ CHEAT TICK ============
    function cheatTick() {
        ensureSpeedHook(); ensureSpreadHook();
        if (!playing()) return;
        var P = player(), W = weapons();
        try { if (isFeatureActive('ragebot_norecoil') && W && W.clearViewPunch) W.clearViewPunch(); } catch (e) { }
        try { if (isFeatureActive('ragebot_norecoil') && W) { W.punchP = 0; W.punchY = 0; if (W.punch) W.punch.index = 0; } } catch (e) { }
        try { if (isFeatureActive('ragebot_nospread') && W) { if (W.acc) W.acc.penalty = 0; if (W._acc && typeof W._acc === 'object' && 'penalty' in W._acc) W._acc.penalty = 0; } } catch (e) { }
        try { if (isFeatureActive('ragebot_rapid') && W) { W.nextFire = 0; W.reloading = false; W.reloadT = 0; } } catch (e) { }
        try { if (isFeatureActive('infammo')) { P.ammo = 999; P.reserve = 999; if (W && W.state) { var st = W.state(); if (st) { st.ammo = 999; st.reserve = 999; } } } } catch (e) { }
        try { if (isFeatureActive('godmode')) P.health = 100; } catch (e) { }
        try { if (isFeatureActive('armor')) { P.armor = 100; P.helmet = true; } } catch (e) { }
        try { if (isFeatureActive('antiflash')) { P.flashUntil = 0; P.blindUntil = 0; } } catch (e) { }
        try { if (isFeatureActive('infmoney')) P.money = 16000; } catch (e) { }
        try { if (CFG.bhop && bhopActive && P.onGround) P.jumpBuffer = 0.15; } catch (e) { }
        try { if (isFeatureActive('jumppower') && wasOnGround && !P.onGround && P.vy > 0) P.vy = P.vy * (CFG.jumppower_mult || 1.5); wasOnGround = P.onGround; } catch (e) { }
        try { if (P.y < -25) { P.y = 10; P.vy = 0; } } catch (e) { }
    }

    // ============ THIRD PERSON ============
    function thirdPersonTick() {
        if (!isFeatureActive('thirdperson') || !G || !G.camera || !playing()) return;
        try {
            var P = player(), eye = eyeOf(P), dir = viewDir(P.yaw, P.pitch), dist = CFG.thirdperson_distance || 4;
            var camX = eye.x - dir.x * dist, camY = eye.y - dir.y * dist + 1.0, camZ = eye.z - dir.z * dist;
            try { if (!visClear(eye.x, eye.y, eye.z, camX, camY, camZ)) { var d2 = dist * 0.3; camX = eye.x - dir.x * d2; camY = eye.y - dir.y * d2 + 0.6; camZ = eye.z - dir.z * d2; } } catch (e) { }
            G.camera.position.set(camX, camY, camZ); G.camera.updateMatrixWorld(true);
            if (G.camera.matrixWorldInverse && G.camera.matrixWorldInverse.copy) G.camera.matrixWorldInverse.copy(G.camera.matrixWorld).invert();
        } catch (e) { }
    }

    // ============ AMBIENT LIGHT ============
    let ambientLightCache = null, ambientOrig = null;
    function findSceneRoot() { if (G.scene) return G.scene; if (G.camera) { var node = G.camera; while (node.parent) node = node.parent; return node; } return null; }
    function findAmbientLight() {
        if (ambientLightCache) return ambientLightCache;
        var found = null;
        try { if (G._lights && G._lights.sun && G._lights.sun.isLight) found = G._lights.sun; } catch (e) { }
        if (!found) { var scene = findSceneRoot(); if (scene && typeof scene.traverse === 'function') { try { scene.traverse(function (node) { if (!found && node.isLight && node.isAmbientLight) found = node; }); if (!found) { scene.traverse(function (node) { if (!found && node.isLight && node.isHemisphereLight) found = node; }); } } catch (e) { } } }
        ambientLightCache = found; return found;
    }
    function ambientTick() {
        var light = findAmbientLight(); if (!light) return;
        var active = isFeatureActive('ambient_color');
        try {
            if (active) { if (!ambientOrig) ambientOrig = { color: light.color.clone(), intensity: light.intensity }; light.color.set(CFG.ambient_color_value || '#ffffff'); light.intensity = CFG.ambient_intensity; }
            else if (ambientOrig) { light.color.copy(ambientOrig.color); light.intensity = ambientOrig.intensity; ambientOrig = null; }
        } catch (e) { }
    }

    // ============ CHAMS ============
    const chammedSet = new Set();
    function isFlatMesh(node) {
        try {
            if (!node.geometry) return false;
            if (!node.geometry.boundingBox && typeof node.geometry.computeBoundingBox === 'function') node.geometry.computeBoundingBox();
            var bb = node.geometry.boundingBox; if (!bb) return false;
            if (typeof node.updateWorldMatrix === 'function') node.updateWorldMatrix(true, false); else if (typeof node.updateMatrixWorld === 'function') node.updateMatrixWorld(true);
            var m = node.matrixWorld; if (!m || !m.elements) return false;
            var e = m.elements, corners = [[bb.min.x,bb.min.y,bb.min.z],[bb.max.x,bb.min.y,bb.min.z],[bb.min.x,bb.max.y,bb.min.z],[bb.max.x,bb.max.y,bb.min.z],[bb.min.x,bb.min.y,bb.max.z],[bb.max.x,bb.min.y,bb.max.z],[bb.min.x,bb.max.y,bb.max.z],[bb.max.x,bb.max.y,bb.max.z]];
            var minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity,minZ=Infinity,maxZ=-Infinity;
            for (var i=0;i<8;i++){var x=corners[i][0],y=corners[i][1],z=corners[i][2];var wx=e[0]*x+e[4]*y+e[8]*z+e[12],wy=e[1]*x+e[5]*y+e[9]*z+e[13],wz=e[2]*x+e[6]*y+e[10]*z+e[14];if(wx<minX)minX=wx;if(wx>maxX)maxX=wx;if(wy<minY)minY=wy;if(wy>maxY)maxY=wy;if(wz<minZ)minZ=wz;if(wz>maxZ)maxZ=wz;}
            return Math.min(maxX-minX,maxY-minY,maxZ-minZ)<0.08;
        } catch(e){return false;}
    }
    function collectMeshNodes(entity) {
