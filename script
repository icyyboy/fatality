// ==UserScript==
// @name         FATALITY v13
// @namespace    fatality
// @version      13.0
// @description  HvH menu for clutcher.io - AutoWin, AutoKill, fixes
// @match        *://*.clutcher.io/*
// @grant        none
// @run-at       document-start
// ==/UserScript==
(function () {
    'use strict';

    // ============ CONFIG ============
    const CONFIG_KEY = 'fatality_config_v13';
    const DEFAULT_CONFIG = {
        aimbot: false, aimbot_fov: 25, fov_visible: false, aimbot_smooth: 4,
        aimbot_autofire: false, aimbot_visibleOnly: true, aimbot_target: 'head',
        ragebot_triggerbot: false, triggerbot_delay: 10,
        ragebot_damage_enabled: false, ragebot_damage: 10, ragebot_onetap: false,
        ragebot_rapid: false, ragebot_norecoil: false, ragebot_nospread: false,
        ragebot_aim: false,
        ragebot_enabled: false, ragebot_fov: 180, ragebot_maxdist: 200,
        ragebot_wallbang: true, ragebot_penmargin: 1.05, ragebot_shootdelay: 0,
        ragebot_silent: true, ragebot_teamcheck: true, ragebot_aimbone: 'head',
        ragebot_autofire2: true, ragebot_debug: false,
        infammo: false, infgrenades: false,
        esp: false, esp_boxes: true, esp_health: true, esp_names: true,
        esp_chams: false, esp_headdot: false, esp_skeleton: false,
        esp_visible_color: '#3cff5a', esp_hidden_color: '#ff4444',
        drops_esp: false, drops_esp_maxdist: 80, drops_esp_color: '#ffcc00', drops_esp_fontsize: 12,
        vm_tint: false, vm_color: '#00ff88', vm_opacity: 0.85, vm_tint_strength: 0.55,
        chams_advanced: false, chams_xray: true, chams_relative: false,
        chams_ct_color: '#2196f3', chams_t_color: '#ff5722',
        chams_ally_color: '#00e676', chams_enemy_color: '#ff1744',
        chams_alpha: 0.7, chams_emissive: 0.85,
        hitmarker: false, hitsound: false,
        godmode: false, armor: false, antiflash: false, infmoney: false,
        speed: 1, bhop: false, jumppower: false, jumppower_mult: 1.5,
        thirdperson: false, thirdperson_distance: 3.0, thirdperson_height: 0.65,
        ambient_color: false, ambient_color_value: '#ffffff', ambient_intensity: 2,
        fake_scoped: false, fake_crouch: false,
        spinbot: false, spinbot_speed: 0.35,
        antiaim: false, antiaim_mode: 'backwards', antiaim_yaw_offset: 180,
        custom_crosshair: false, crosshair_size: 8, crosshair_gap: 4,
        crosshair_thickness: 2, crosshair_color: '#00ff99', crosshair_dot: false,
        crosshair_alpha: 1.0, crosshair_style: 'classic',
        fov_editor: false, fov_value: 90,
        tracers: false, tracers_bots: true, tracers_life: 0.5, tracers_width: 2.5,
        silent_aim: false, silent_aim_fov: 25, silent_aim_smooth: 0,
        fog_enabled: false, fog_color: '#8899aa', fog_near: 2, fog_far: 28, fog_density: 0.045,
        bot_ct: 8, bot_t: 3,
        fun_confetti: false, fun_rainbow: false, fun_wireframe: false,
        fun_confetti_count: 80, fun_rainbow_speed: 0.4,
        killfx: false, killfx_mode: 'c4', killfx_big: true,
        killfx_instant: true, killfx_delay: 0, killfx_multi: 1,
        // NEW v13
        autowin: false, autowin_interval: 5,
        autokill: false, autokill_interval: 200,
        //
        particles: true, menu_color: '#ffffff', menu_scale: 100, menu_key: 'Insert',
        modes: {}, skinOpts: {}
    };

    let CFG = { ...DEFAULT_CONFIG };
    function saveCfg() { try { localStorage.setItem(CONFIG_KEY, JSON.stringify(CFG)); } catch (e) { } }
    function loadCfg() {
        try {
            const saved = localStorage.getItem(CONFIG_KEY);
            if (saved) CFG = { ...DEFAULT_CONFIG, ...JSON.parse(saved) };
            if (!CFG.modes) CFG.modes = {};
            if (!CFG.skinOpts) CFG.skinOpts = {};
        } catch (e) { }
    }
    loadCfg();

    // ============ COLOR HELPERS ============
    function hexToRgbTriplet(hex) {
        try { hex = hex.replace('#', ''); if (hex.length === 3) hex = hex.split('').map(c => c + c).join(''); return `${parseInt(hex.slice(0,2),16)}, ${parseInt(hex.slice(2,4),16)}, ${parseInt(hex.slice(4,6),16)}`; } catch(e) { return '255,255,255'; }
    }
    function hexToRgba(hex, a) { return `rgba(${hexToRgbTriplet(hex)}, ${a})`; }
    function applyThemeColor(hex) { document.documentElement.style.setProperty('--fx-accent', hex); document.documentElement.style.setProperty('--fx-accent-rgb', hexToRgbTriplet(hex)); }
    function applyMenuScale(pct) { document.documentElement.style.setProperty('--fx-scale', (pct || 100) / 100); }
    function hexToInt(hex) { try { return parseInt(hex.replace('#',''), 16); } catch(e) { return 0xffffff; } }
    function hexToRgbObj(hex) { const i = hexToInt(hex); return { r:((i>>16)&255)/255, g:((i>>8)&255)/255, b:(i&255)/255 }; }

    // ============ ACTIVATION SYSTEM ============
    const heldKeys = new Set();
    const toggleStates = {};
    function getFeatureMode(id) { if (!CFG.modes) CFG.modes = {}; if (!CFG.modes[id]) CFG.modes[id] = { mode: 'always', key: null }; return CFG.modes[id]; }
    function keyLabel(code) {
        if (!code) return 'Sin asignar';
        if (code === 'Mouse0') return 'Mouse Left'; if (code === 'Mouse1') return 'Mouse Middle';
        if (code === 'Mouse2') return 'Mouse Right'; if (code === 'Mouse3') return 'Mouse 4';
        if (code === 'Mouse4') return 'Mouse 5';
        if (code.startsWith('Key')) return code.slice(3);
        if (code.startsWith('Digit')) return code.slice(5);
        return code;
    }
    function isFeatureActive(id) {
        if (!CFG[id]) return false;
        const m = getFeatureMode(id);
        if (m.mode === 'always') return true;
        if (!m.key) return false;
        if (m.mode === 'toggle') return !!toggleStates[id];
        return heldKeys.has(m.key);
    }
    function handleBindEdge(code) {
        if (!CFG.modes) return;
        Object.keys(CFG.modes).forEach(id => { const m = CFG.modes[id]; if (m.mode === 'toggle' && m.key === code) toggleStates[id] = !toggleStates[id]; });
    }
    document.addEventListener('keydown', (e) => { if (!e.repeat) handleBindEdge(e.code); heldKeys.add(e.code); }, true);
    document.addEventListener('keyup', (e) => { heldKeys.delete(e.code); }, true);
    document.addEventListener('mousedown', (e) => { const c = 'Mouse' + e.button; handleBindEdge(c); heldKeys.add(c); });
    document.addEventListener('mouseup', (e) => { heldKeys.delete('Mouse' + e.button); });
    document.addEventListener('contextmenu', (e) => { if (Object.values(CFG.modes||{}).some(m => m.key === 'Mouse2' && m.mode !== 'always')) e.preventDefault(); });

    // ============ GAME REFERENCES ============
    let G = null, hooked = false, orig = {}, lockTarget = null, bhopActive = false, wasOnGround = true;
    let _lastG = null; // track G identity for reset logic
    function player() { return (G && G.player) || null; }
    function weapons() { return (G && G.weapons) || null; }
    function playing() { var P = player(); return !!(G && G.state === 'playing' && P && P.alive); }
    function eyeOf(e) { return { x: e.x, y: e.y + (e.eyeH || 1.6) - (e._stepLift || 0), z: e.z }; }
    function baseYOf(e) { return (e._visY == null ? e.y : e._visY); }
    function aimPointOf(e, bone) { var b = baseYOf(e); bone = bone || CFG.aimbot_target; return bone === 'head' ? { x: e.x, y: b + 1.55, z: e.z } : { x: e.x, y: b + 0.95, z: e.z }; }
    function enemies() {
        var P = player(), out = [];
        if (!G || !P || !G.allEntities) return out;
        var list; try { list = G.allEntities(); } catch(e) { return out; }
        for (var i = 0; i < list.length; i++) {
            var e = list[i];
            if (!e || e === P || !e.alive) continue;
            if (!e.team || e.team === P.team) continue;
            if ((e.spawnProt || 0) > 0) continue;
            out.push(e);
        }
        return out;
    }
    function viewDir(yaw, pitch) { var o = Math.cos(pitch); return { x: -Math.sin(yaw)*o, y: Math.sin(pitch), z: -Math.cos(yaw)*o }; }
    function wantAngles(from, to) {
        var dx=to.x-from.x, dy=to.y-from.y, dz=to.z-from.z, len=Math.sqrt(dx*dx+dy*dy+dz*dz)||0.0001;
        return { yaw: Math.atan2(-dx,-dz), pitch: Math.asin(Math.max(-1,Math.min(1,dy/len))), dist: len };
    }
    function wrapPi(a) { while(a>Math.PI)a-=Math.PI*2; while(a<-Math.PI)a+=Math.PI*2; return a; }
    function visClear(x1,y1,z1,x2,y2,z2) { try { return !!G.physics.lineClear(x1,y1,z1,x2,y2,z2); } catch(e) { return true; } }

    // ============ HIT MARKER / HIT SOUND ============
    let hitMarkerUntil = 0, hitMarkerIsKill = false, audioCtx = null;
    function playHitSound(isKill) {
        try {
            if (!audioCtx) audioCtx = new (window.AudioContext||window.webkitAudioContext)();
            var o = audioCtx.createOscillator(), g = audioCtx.createGain();
            o.type = 'square'; o.frequency.value = isKill ? 1300 : 850; g.gain.value = 0.18;
            o.connect(g); g.connect(audioCtx.destination);
            var t = audioCtx.currentTime;
            g.gain.setValueAtTime(0.18,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.09);
            o.start(t); o.stop(t+0.1);
            if (isKill) {
                var o2=audioCtx.createOscillator(),g2=audioCtx.createGain();
                o2.type='square'; o2.frequency.value=1700; g2.gain.value=0.15;
                o2.connect(g2); g2.connect(audioCtx.destination);
                o2.start(t+0.07); g2.gain.setValueAtTime(0.15,t+0.07);
                g2.gain.exponentialRampToValueAtTime(0.001,t+0.16); o2.stop(t+0.17);
            }
        } catch(e) {}
    }
    function triggerHitFeedback(isKill) {
        if (CFG.hitmarker) { hitMarkerUntil = performance.now() + (isKill ? 260 : 150); hitMarkerIsKill = isKill; }
        if (CFG.hitsound) playHitSound(isKill);
    }
    function drawHitMarker() {
        if (performance.now() > hitMarkerUntil) return;
        var cx=espCanvas.width/2, cy=espCanvas.height/2, s=hitMarkerIsKill?11:7, gap=4;
        espCtx.strokeStyle = hitMarkerIsKill ? '#ff3b3b' : '#ffffff'; espCtx.lineWidth = 2;
        espCtx.beginPath();
        espCtx.moveTo(cx-s-gap,cy-s-gap); espCtx.lineTo(cx-gap,cy-gap);
        espCtx.moveTo(cx+gap,cy+gap); espCtx.lineTo(cx+s+gap,cy+s+gap);
        espCtx.moveTo(cx+s+gap,cy-s-gap); espCtx.lineTo(cx+gap,cy-gap);
        espCtx.moveTo(cx-gap,cy+gap); espCtx.lineTo(cx-s-gap,cy+s+gap);
        espCtx.stroke();
    }

    // ============ RAGEBOT ============
    const MR = 0.0254;
    const PEN_FALLBACK = {
        ak47:2,m4a4:2,m4a1s:2,aug:2,sg553:2,galil:2,famas:2,
        awp:2.5,ssg08:2.5,scar20:2.5,g3sg1:2.5,
        deagle:2,revolver:2,cz75:1,fiveseven:1,glock:1,usp:1,p2000:1,
        p250:1,tec9:1,elite:1,dualies:1,
        mp9:1,mp7:1,mp5sd:1,mac10:1,ump45:1,bizon:1,p90:1,
        nova:1,xm1014:1,mag7:1,sawedoff:1,m249:2,negev:2,
        knife:0,zeus:0
    };
    let rageLastShot = 0;

    function rageGetWeaponInfo() {
        const w = G && G.weapons;
        if (!w) return { id: null, def: null, pen: 0 };
        const id = w.current;
        let def = null;
        try { def = w.def ? w.def() : null; } catch (_e) {}
        let pen = 0;
        if (def) { if (def.penetration != null) pen = +def.penetration; else if (def.pen != null) pen = +def.pen; }
        if (!pen && id && PEN_FALLBACK[id] != null) pen = PEN_FALLBACK[id];
        return { id, def, pen: +pen || 0 };
    }
    function rageMatFactor(mat) {
        if (!mat) return [0.55, 0.5];
        const m = String(mat).toLowerCase();
        if (m.includes('blockbullet')) return [0.01, 0.001];
        if (m.includes('metal') && !m.includes('grate') && !m.includes('vent')) return [0.28, 0.22];
        if (m.includes('concrete') || m.includes('brick')) return [0.4, 0.28];
        if (m.includes('rock') || m.includes('asphalt')) return [0.45, 0.3];
        if (m.includes('wood') || m.includes('crate') || m.includes('plank')) return [0.9, 0.6];
        if (m.includes('glass') || m.includes('plaster') || m.includes('sheetrock')) return [0.95, 0.7];
        if (m.includes('grate') || m.includes('vent') || m.includes('cardboard') || m.includes('plastic')) return [0.95, 0.75];
        if (m.includes('dirt') || m.includes('sand') || m.includes('gravel')) return [0.5, 0.35];
        return [0.55, 0.45];
    }
    function rageWallPenCost(thickness, M) {
        const m = Math.max(M, 0.05);
        const metersPerPen = 30 * m * MR;
        if (metersPerPen <= 1e-8) return 999;
        return thickness / metersPerPen;
    }
    function rageSimulateTrail(eye, aim, pen) {
        const phys = G && G.physics;
        if (!phys || !phys.raycast) return { ok: true, walls: [], totalCost: 0, reason: 'no-phys' };
        try { if (phys.lineClear(eye.x, eye.y, eye.z, aim.x, aim.y, aim.z)) return { ok: true, walls: [], totalCost: 0, reason: 'clear' }; } catch (_e) {}
        if (!CFG.ragebot_wallbang) return { ok: false, walls: [], totalCost: 0, reason: 'wallbang-off' };
        if (pen <= 0) return { ok: false, walls: [], totalCost: 0, reason: 'no-pen' };
        const dx = aim.x - eye.x, dy = aim.y - eye.y, dz = aim.z - eye.z;
        const dist = Math.hypot(dx, dy, dz);
        if (dist < 0.15) return { ok: true, walls: [], totalCost: 0 };
        const ix = dx/dist, iy = dy/dist, iz = dz/dist;
        const l = pen * 30;
        let surfaces = l > 0 ? 4 : 0;
        let f = 0;
        const walls = [];
        let totalCost = 0;
        for (let iter = 0; iter < 12; iter++) {
            const remain = dist - f;
            if (remain <= 0.06) break;
            const px = eye.x + ix*f, py = eye.y + iy*f, pz = eye.z + iz*f;
            const hit = phys.raycast(px, py, pz, ix, iy, iz, remain + 0.05, 2);
            if (!hit || hit.t >= remain - 0.08) break;
            if (hit.b && hit.b.tri) return { ok: false, walls, totalCost, reason: 'tri-solid', mat: hit.mat };
            if (surfaces <= 0) return { ok: false, walls, totalCost, reason: 'surfaces-exhausted' };
            const [M, N] = rageMatFactor(hit.mat);
            const ee = Math.min(90, l * M);
            if (!(ee > 0)) return { ok: false, walls, totalCost, reason: 'no-budget', mat: hit.mat };
            let exit = -1;
            if (phys.traceExit) {
                exit = phys.traceExit(hit.x, hit.y, hit.z, ix, iy, iz, ee * MR, 4 * MR, 2);
            } else if (phys.pointSolid) {
                for (let d = 4*MR; d <= ee*MR; d += 4*MR) {
                    if (!phys.pointSolid(hit.x + ix*d, hit.y + iy*d, hit.z + iz*d, 2)) { exit = d; break; }
                }
            }
            if (exit == null || exit < 0) return { ok: false, walls, totalCost, reason: 'no-exit', mat: hit.mat };
            const cost = rageWallPenCost(exit, M);
            totalCost += cost;
            walls.push({ mat: hit.mat||'?', thick: +exit.toFixed(4), cost: +cost.toFixed(3) });
            surfaces--;
            f = f + hit.t + exit + 0.002;
        }
        const needed = totalCost * (CFG.ragebot_penmargin || 1);
        if (walls.length >= 1 && needed > pen) return { ok: false, walls, totalCost: +totalCost.toFixed(3), reason: 'sum-exceeds-pen' };
        return { ok: true, walls, totalCost: +totalCost.toFixed(3), reason: walls.length ? 'bang-ok' : 'clear' };
    }
    function ragePickTarget() {
        const p = G.player;
        if (!p || !p.alive) return null;
        const { id, def, pen } = rageGetWeaponInfo();
        const eye = { x: p.x, y: p.y + (p.eyeH || 1.6) - (p._stepLift || 0), z: p.z };
        let best = null, bestScore = Infinity;
        const fovLim = (CFG.ragebot_fov || 180) * Math.PI / 180;
        const list = G.allEntities ? G.allEntities() : (G.botMgr && G.botMgr.bots) || [];
        for (const e of list) {
            if (!e || e === p || !e.alive) continue;
            if (CFG.ragebot_teamcheck && e.team === p.team) continue;
            if (e.isPlayer && e.spawnProt > 0) continue;
            const aim = aimPointOf(e, CFG.ragebot_aimbone);
            const dx = aim.x - eye.x, dy = aim.y - eye.y, dz = aim.z - eye.z;
            const dist = Math.hypot(dx, dy, dz);
            if (dist < 0.5 || dist > (CFG.ragebot_maxdist || 200)) continue;
            const yawTo = Math.atan2(-dx, -dz);
            const pitchTo = Math.atan2(dy, Math.hypot(dx, dz));
            const fovAng = Math.hypot(Math.abs(wrapPi(yawTo - p.yaw)), Math.abs(wrapPi(pitchTo - (p.pitch||0))));
            if (fovAng > fovLim) continue;
            const trail = rageSimulateTrail(eye, aim, pen);
            if (!trail.ok) continue;
            const score = fovAng * 8 + dist * 0.04 + trail.totalCost * 2 + trail.walls.length * 0.3;
            if (score < bestScore) {
                bestScore = score;
                best = { ent: e, aim, eye, dist, yawTo, pitchTo, dx, dy, dz, pen, weapon: id, walls: trail.walls, totalCost: trail.totalCost };
            }
        }
        return best;
    }
    function rageCanFire() {
        const w = G.weapons;
        if (!w) return false;
        const def = w.def && w.def();
        if (!def || def.class === 'knife' || def.class === 'grenade' || def.class === 'c4') return false;
        const st = w.state && w.state();
        if (!st || st.ammo <= 0) return false;
        if (w.reloading || w.grenadeCooking) return false;
        if (G.time < (w.nextFire || 0)) return false;
        return true;
    }
    function rageSilentShot(t) {
        const w = G.weapons;
        const def = w.def();
        const st = w.state();
        if (!def || !st || st.ammo <= 0) return;
        if (def.penetration == null && t.pen > 0) def.penetration = t.pen;
        if (def.pen == null && t.pen > 0) def.pen = t.pen;
        let dx = t.dx, dy = t.dy, dz = t.dz;
        const len = Math.hypot(dx, dy, dz) || 1;
        dx /= len; dy /= len; dz /= len;
        st.ammo--;
        w.nextFire = G.time + (def.boltTime ? def.boltTime : (w.cycleTime ? w.cycleTime() : 0.1));
        w.lastShotT = G.time;
        G.fireBullet(G.player, t.eye.x, t.eye.y, t.eye.z, dx, dy, dz, def);
        try {
            if (G.audio && def.sound) G.audio.play(def.sound);
            if (G.viewmodel && G.viewmodel.kick) G.viewmodel.kick(def);
            if (G.hud && G.hud.updateWeapon) G.hud.updateWeapon();
        } catch (_e) {}
    }
    function rageTick() {
        if (!CFG.ragebot_enabled || !G || !G.player || !G.player.alive) return;
        if (G.state && G.state !== 'playing') return;
        if (!CFG.ragebot_autofire2 || !rageCanFire()) return;
        const now = performance.now();
        if (now - rageLastShot < (CFG.ragebot_shootdelay || 0)) return;
        const t = ragePickTarget();
        if (!t) return;
        rageSilentShot(t);
        rageLastShot = now;
    }

    // ============ AUTO KILL (force wallbang - kill all enemies via dealDamage) ============
    let autoKillLastTime = 0;
    function autoKillTick() {
        if (!isFeatureActive('autokill') || !G || !G.player || !G.player.alive) return;
        if (G.state && G.state !== 'playing') return;
        const now = performance.now();
        const interval = Math.max(50, CFG.autokill_interval || 200);
        if (now - autoKillLastTime < interval) return;
        autoKillLastTime = now;

        const p = G.player;
        const list = G.allEntities ? G.allEntities() : (G.botMgr && G.botMgr.bots) || [];
        const def = (G.weapons && G.weapons.def && G.weapons.def()) || { dmg: 36, class: 'rifle', hs: 4 };

        for (const e of list) {
            if (!e || e === p || !e.alive) continue;
            if (e.team === p.team) continue;
            if ((e.spawnProt || 0) > 0) continue;
            try {
                if (typeof G.dealDamage === 'function') {
                    G.dealDamage(e, 9999, p, true, def, 'head', 0, true);
                } else {
                    e.health = 0;
                    e.alive = false;
                }
            } catch (_e) {
                try { e.health = 0; e.alive = false; } catch (_e) {}
            }
        }
    }

    // ============ AUTO WIN ============
    let autoWinLastCheck = 0, autoWinWatchedState = null;
    function detectMyTeam() {
        if (!G || !G.player) return null;
        const p = G.player;
        if (p.team === 'CT' || p.team === 'T') return p.team;
        return null;
    }
    function doWinRound(team) {
        if (!G) return false;
        try {
            if (G.modeCtl && typeof G.modeCtl.roundEnd === 'function') {
                if (G.modeCtl.state === 'end' || G.modeCtl.state === 'match_end') return false;
                G.modeCtl.roundEnd(team, 'eliminated');
                return true;
            }
            if (typeof G.roundEnd === 'function') {
                G.roundEnd(team, '');
                return true;
            }
            // Fallback: kill all enemies
            const enemy = team === 'CT' ? 'T' : 'CT';
            const list = G.allEntities ? G.allEntities() : (G.botMgr && G.botMgr.bots) || [];
            for (const e of list) {
                if (!e || e === G.player || !e.alive || e.team !== enemy) continue;
                try { if (typeof G.dealDamage === 'function') G.dealDamage(e, 9999, G.player, true); else { e.health = 0; e.alive = false; } } catch (_e) {}
            }
            return true;
        } catch (_e) { return false; }
    }
    function autoWinTick() {
        if (!isFeatureActive('autowin') || !G) return;
        const now = performance.now();
        const interval = Math.max(1000, (CFG.autowin_interval || 5) * 1000);
        if (now - autoWinLastCheck < interval) return;
        autoWinLastCheck = now;

        const state = G.state || (G.modeCtl && G.modeCtl.state);
        if (state !== 'playing' && state !== 'freeze') return;

        const team = detectMyTeam();
        if (!team) return;
        doWinRound(team);
    }
    // Manual instant win (button)
    function forceWinNow(team) {
        if (!G) { setStatus('No hay partida'); return; }
        const t = team || detectMyTeam() || 'CT';
        const ok = doWinRound(t);
        setStatus(ok ? 'Win ' + t + ' ejecutado' : 'roundEnd no encontrado');
    }

    // ============ BOT PATCH ============
    let botPatchApplied = false;
    function applyBotPatch() {
        if (!G || !G.botMgr) { setStatus('botMgr no encontrado - inicia partida'); return; }
        const mgr = G.botMgr;
        if (!botPatchApplied) {
            const origSetup = mgr.setup.bind(mgr);
            mgr.setup = function(total, difficulty, playerTeam) {
                const need = CFG.bot_ct + CFG.bot_t;
                origSetup(Math.max(need, 1), difficulty, playerTeam);
                const Bot = this.bots[0] && this.bots[0].constructor;
                if (!Bot) { console.error('[bot patch] no Bot constructor'); return; }
                for (const b of this.bots) {
                    try { G.scene.remove(b.mesh); G.scene.remove(b.shadow); if (b.cs2Agent) G.scene.remove(b.cs2Agent.root); } catch (_e) {}
                }
                this.bots.length = 0;
                const names = (G._nextBotNames) || [];
                let idx = 0;
                const add = (team) => {
                    const name = names[idx % (names.length || 1)] || ('Bot' + idx);
                    this.bots.push(new Bot(G, team, name, difficulty));
                    idx++;
                };
                for (let i = 0; i < CFG.bot_ct; i++) add('CT');
                for (let i = 0; i < CFG.bot_t; i++) add('T');
                console.log(`[bot patch] CT=${CFG.bot_ct}  T=${CFG.bot_t}`);
            };
            botPatchApplied = true;
        }
        setStatus(`Bot patch OK - CT:${CFG.bot_ct} T:${CFG.bot_t} - inicia nueva partida`);
    }

