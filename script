        try { orig.damagePlayer = G.damagePlayer.bind(G); G.damagePlayer = function(amount, atk, a2, type) { if (isFeatureActive('godmode')) return; return orig.damagePlayer(amount, atk, a2, type); }; } catch(e) {}
