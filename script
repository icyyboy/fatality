    // ============ DROPS ESP ============
    let dropsEspCanvas = null, dropsEspCtx = null;
    function ensureDropsEsp() {
        if (dropsEspCanvas) return;
        dropsEspCanvas = document.createElement('canvas');
        dropsEspCanvas.id = 'fx-drops-esp';
        dropsEspCanvas.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:99998;';
        document.body.appendChild(dropsEspCanvas);
        dropsEspCtx = dropsEspCanvas.getContext('2d');
        const resize = () => { dropsEspCanvas.width = innerWidth; dropsEspCanvas.height = innerHeight; };
        resize(); window.addEventListener('resize', resize);
    }
    function projectDrops(wx, wy, wz) {
        const cam = G && G.camera;
        if (!cam || !cam.matrixWorldInverse || !cam.projectionMatrix) return null;
        const e = cam.matrixWorldInverse.elements, p = cam.projectionMatrix.elements;
        const vx=e[0]*wx+e[4]*wy+e[8]*wz+e[12], vy=e[1]*wx+e[5]*wy+e[9]*wz+e[13];
        const vz=e[2]*wx+e[6]*wy+e[10]*wz+e[14], vw=e[3]*wx+e[7]*wy+e[11]*wz+e[15];
        const cx=p[0]*vx+p[4]*vy+p[8]*vz+p[12]*vw, cy=p[1]*vx+p[5]*vy+p[9]*vz+p[13]*vw;
        const cz=p[2]*vx+p[6]*vy+p[10]*vz+p[14]*vw, cw=p[3]*vx+p[7]*vy+p[11]*vz+p[15]*vw;
        if (!cw) return null;
        const ndcX=cx/cw, ndcY=cy/cw, ndcZ=cz/cw;
        if (ndcZ < -1 || ndcZ > 1) return null;
        return { x:(ndcX*0.5+0.5)*dropsEspCanvas.width, y:(-ndcY*0.5+0.5)*dropsEspCanvas.height };
    }
    function dropsEspTick() {
        if (!dropsEspCanvas) return;
        if (!CFG.drops_esp) { dropsEspCtx.clearRect(0,0,dropsEspCanvas.width,dropsEspCanvas.height); return; }
        dropsEspCtx.clearRect(0,0,dropsEspCanvas.width,dropsEspCanvas.height);
        if (!G || !G.drops || !G.player) return;
        const px = G.player.x, pz = G.player.z;
        dropsEspCtx.font = `bold ${CFG.drops_esp_fontsize||12}px monospace`;
        dropsEspCtx.textAlign = 'center';
        dropsEspCtx.lineWidth = 3;
        for (const d of G.drops) {
            if (!d || d.x == null) continue;
            const dist = Math.hypot(d.x - px, d.z - pz);
            if (dist > (CFG.drops_esp_maxdist||80)) continue;
            const scr = projectDrops(d.x, (d.y||0)+0.35, d.z);
            if (!scr || scr.x<0 || scr.x>dropsEspCanvas.width || scr.y<0 || scr.y>dropsEspCanvas.height) continue;
            const label = (d.id||'drop') + ' ' + dist.toFixed(0) + 'm';
            dropsEspCtx.strokeStyle = '#000'; dropsEspCtx.fillStyle = CFG.drops_esp_color||'#ffcc00';
            dropsEspCtx.strokeText(label, scr.x, scr.y); dropsEspCtx.fillText(label, scr.x, scr.y);
            dropsEspCtx.strokeStyle = CFG.drops_esp_color||'#ffcc00';
            dropsEspCtx.strokeRect(scr.x-5, scr.y+4, 10, 10);
        }
    }

    // ============ HOOKS ============
    function installHooks() {
