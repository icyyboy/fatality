// ==UserScript==
// @name         Fatality Loader
// @namespace    fatality
// @version      3.1.0
// @description  Fatality loader con licencia
// @match        *://*/*
// @grant        GM_xmlhttpRequest
// @grant        GM_addElement
// @grant        GM_addStyle
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_deleteValue
// @grant        GM_openInTab
// @grant        GM_notification
// @grant        GM_registerMenuCommand
// @grant        unsafeWindow
// @connect      rlcbuceoulhwvnlbtmou.supabase.co
// @connect      raw.githubusercontent.com
// @run-at       document-start
// ==/UserScript==

(function () {
    "use strict";

    const SUPABASE_FUNCTION =
        "https://rlcbuceoulhwvnlbtmou.supabase.co/functions/v1/fatality-auth";

    const SUPABASE_PUBLISHABLE_KEY =
        "sb_publishable_1es_aKHn6NtQapDD1qZqYA_80KmVESg";

    const SCRIPT_URL =
        "https://raw.githubusercontent.com/icyyboy/fatality/refs/heads/main/script";

    const STORAGE_KEY = "fatality_license";

    let ui = null;

    // =========================================================
    // SUPABASE
    // =========================================================

    function api(data) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method: "POST",
                url: SUPABASE_FUNCTION,

                headers: {
                    "Content-Type": "application/json",
                    "apikey": SUPABASE_PUBLISHABLE_KEY
                },

                data: JSON.stringify(data),

                onload(response) {
                    try {
                        const json =
                            JSON.parse(response.responseText);

                        resolve({
                            status: response.status,
                            data: json
                        });
                    } catch {
                        reject(
                            new Error("Invalid server response")
                        );
                    }
                },

                onerror() {
                    reject(
                        new Error("Connection failed")
                    );
                }
            });
        });
    }

    async function validate(key) {
        const response = await api({
            action: "validate",
            key: key
        });

        return response.data;
    }

    // =========================================================
    // SCRIPT DOWNLOAD
    // =========================================================

    function downloadScript() {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method: "GET",
                url: SCRIPT_URL,

                onload(response) {
                    if (response.status !== 200) {
                        reject(
                            new Error(
                                "Script download failed"
                            )
                        );
                        return;
                    }

                    if (
                        !response.responseText ||
                        !response.responseText.trim()
                    ) {
                        reject(
                            new Error(
                                "Empty script"
                            )
                        );
                        return;
                    }

                    resolve(response.responseText);
                },

                onerror() {
                    reject(
                        new Error(
                            "Script download failed"
                        )
                    );
                }
            });
        });
    }

    // =========================================================
    // SCRIPT EXECUTION
    // =========================================================

    function cleanUserscript(code) {
        /*
         * Elimina únicamente el bloque de metadata
         * de Tampermonkey.
         *
         * El resto del código se conserva.
         */

        return code.replace(
            /\/\/ ==UserScript==[\s\S]*?\/\/ ==\/UserScript==/i,
            ""
        );
    }

    function executeScript(code) {
        const cleanCode =
            cleanUserscript(code);

        /*
         * Ejecutamos el script proporcionando las APIs
         * habituales de Tampermonkey.
         *
         * Esto es importante porque el archivo remoto
         * originalmente está escrito como userscript.
         */

        const runner = new Function(
            "window",
            "unsafeWindow",
            "document",

            "GM_xmlhttpRequest",
            "GM_addElement",
            "GM_addStyle",

            "GM_getValue",
            "GM_setValue",
            "GM_deleteValue",

            "GM_openInTab",
            "GM_notification",
            "GM_registerMenuCommand",

            cleanCode
        );

        runner(
            unsafeWindow,
            unsafeWindow,
            unsafeWindow.document,

            GM_xmlhttpRequest,
            GM_addElement,
            GM_addStyle,

            GM_getValue,
            GM_setValue,
            GM_deleteValue,

            GM_openInTab,
            GM_notification,
            GM_registerMenuCommand
        );
    }

    // =========================================================
    // UI
    // =========================================================

    function createUI() {
        if (document.getElementById("fatality-license-ui")) {
            return;
        }

        const style =
            document.createElement("style");

        style.id =
            "fatality-license-style";

        style.textContent = `
            #fatality-license-ui {
                position: fixed;
                inset: 0;
                z-index: 2147483647;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family:
                    Inter,
                    system-ui,
                    -apple-system,
                    BlinkMacSystemFont,
                    "Segoe UI",
                    sans-serif;
            }

            #fatality-license-ui .bg {
                position: absolute;
                inset: 0;
                background:
                    radial-gradient(
                        circle at center,
                        rgba(255,255,255,.08),
                        transparent 45%
                    ),
                    #07090d;
                backdrop-filter: blur(12px);
            }

            #fatality-license-ui .card {
                position: relative;
                width: min(
                    420px,
                    calc(100vw - 36px)
                );

                padding: 34px;

                background: #0d1016;
                border: 1px solid #252b35;
                border-radius: 20px;

                box-shadow:
                    0 30px 100px rgba(0,0,0,.65);

                text-align: center;
            }

            #fatality-license-ui .logo {
                width: 58px;
                height: 58px;

                margin: 0 auto 16px;

                display: grid;
                place-items: center;

                border-radius: 16px;

                background: #fff;
                color: #07090d;

                font-size: 28px;
                font-weight: 950;
            }

            #fatality-license-ui .title {
                color: #fff;
                font-size: 25px;
                font-weight: 900;
                letter-spacing: .16em;
            }

            #fatality-license-ui .subtitle {
                margin-top: 6px;

                color: #727b89;

                font-size: 10px;
                font-weight: 800;
                letter-spacing: .2em;
            }

            #fatality-license-ui .line {
                height: 1px;
                margin: 25px 0;

                background: #202631;
            }

            #fatality-license-ui label {
                display: block;

                margin-bottom: 9px;

                color: #9aa3b1;

                font-size: 11px;
                font-weight: 800;

                text-align: left;
            }

            #fatality-license-ui input {
                width: 100%;
                height: 46px;

                padding: 0 14px;

                box-sizing: border-box;

                border: 1px solid #2b323e;
                border-radius: 10px;

                outline: none;

                background: #080b10;
                color: #fff;

                font-family:
                    ui-monospace,
                    monospace;

                font-size: 12px;
            }

            #fatality-license-ui input:focus {
                border-color: #fff;
            }

            #fatality-license-ui button {
                width: 100%;
                height: 46px;

                margin-top: 12px;

                border: 0;
                border-radius: 10px;

                background: #fff;
                color: #07090d;

                font-size: 12px;
                font-weight: 900;

                letter-spacing: .08em;

                cursor: pointer;
            }

            #fatality-license-ui button:disabled {
                opacity: .5;
                cursor: wait;
            }

            #fatality-license-status {
                min-height: 20px;

                margin-top: 15px;

                color: #737d8c;

                font-size: 11px;
                line-height: 1.5;
            }

            #fatality-license-status.error {
                color: #ff8f8f;
            }

            #fatality-license-status.success {
                color: #8ee6a8;
            }

            #fatality-license-ui .footer {
                margin-top: 25px;

                color: #454d59;

                font-size: 9px;
                letter-spacing: .08em;

                text-transform: uppercase;
            }
        `;

        document.documentElement.appendChild(style);

        ui = document.createElement("div");

        ui.id =
            "fatality-license-ui";

        ui.innerHTML = `
            <div class="bg"></div>

            <div class="card">

                <div class="logo">
                    F
                </div>

                <div class="title">
                    FATALITY
                </div>

                <div class="subtitle">
                    LICENSE VERIFICATION
                </div>

                <div class="line"></div>

                <label>
                    LICENSE KEY
                </label>

                <input
                    id="fatality-license-input"
                    type="text"
                    autocomplete="off"
                    spellcheck="false"
                    placeholder="FATALITY-XXXXXXXXXXXXXXXX"
                >

                <button
                    id="fatality-license-button"
                >
                    VERIFY LICENSE
                </button>

                <div
                    id="fatality-license-status"
                >
                    Enter your license key to continue.
                </div>

                <div class="footer">
                    Fatality License System
                </div>

            </div>
        `;

        document.documentElement.appendChild(ui);

        const input =
            document.getElementById(
                "fatality-license-input"
            );

        const button =
            document.getElementById(
                "fatality-license-button"
            );

        button.onclick =
            () => validateFromUI(input, button);

        input.onkeydown =
            event => {
                if (event.key === "Enter") {
                    validateFromUI(
                        input,
                        button
                    );
                }
            };

        setTimeout(
            () => input.focus(),
            100
        );
    }

    async function validateFromUI(
        input,
        button
    ) {
        const key =
            input.value.trim();

        const status =
            document.getElementById(
                "fatality-license-status"
            );

        if (!key) {
            status.textContent =
                "Enter a license key.";

            status.className =
                "error";

            return;
        }

        input.disabled = true;
        button.disabled = true;

        status.textContent =
            "Verifying license...";

        status.className = "";

        try {
            const result =
                await validate(key);

            if (
                !result.valid
            ) {
                localStorage.removeItem(
                    STORAGE_KEY
                );

                status.textContent =
                    "Invalid, revoked or expired license.";

                status.className =
                    "error";

                input.disabled = false;
                button.disabled = false;

                return;
            }

            localStorage.setItem(
                STORAGE_KEY,
                key
            );

            status.textContent =
                "License verified.";

            status.className =
                "success";

            removeUI();

            const code =
                await downloadScript();

            executeScript(code);

        } catch {
            status.textContent =
                "Could not connect to the license server.";

            status.className =
                "error";

            input.disabled = false;
            button.disabled = false;
        }
    }

    function removeUI() {
        if (ui) {
            ui.remove();
            ui = null;
        }

        const style =
            document.getElementById(
                "fatality-license-style"
            );

        if (style) {
            style.remove();
        }
    }

    // =========================================================
    // START
    // =========================================================

    async function start() {
        const savedKey =
            localStorage.getItem(
                STORAGE_KEY
            );

        /*
         * KEY GUARDADA
         *
         * No mostramos absolutamente nada.
         * Primero comprobamos silenciosamente.
         */

        if (savedKey) {
            try {
                const result =
                    await validate(savedKey);

                if (result.valid) {
                    const code =
                        await downloadScript();

                    executeScript(code);

                    return;
                }

                /*
                 * La key existe pero ya no es válida.
                 * Se elimina y mostramos el panel.
                 */

                localStorage.removeItem(
                    STORAGE_KEY
                );

            } catch {
                /*
                 * Si Supabase está temporalmente
                 * caído, no molestamos al usuario.
                 */
                return;
            }
        }

        createUI();
    }

    start();

})();

