                <button class="bind-btn" id="menu-key-bind">${keyLabel(CFG.menu_key||'Insert')}</button>
            </div>
            <div class="fx-section"><div class="fx-section-title">Tema</div>
                <span class="fx-color-label">Color del menú</span>
                <input type="color" id="menu_color" class="fx-color-input" value="${CFG.menu_color}">
            </div>
            <div class="fx-section"><div class="fx-section-title">Escala</div>
                ${sliderRow('menu_scale','Escala',30,300,5,CFG.menu_scale,'%')}
            </div>
            <div class="fx-section"><div class="fx-section-title">Config</div>
                <button class="fx-btn" id="export-cfg">Export Config</button>
                <button class="fx-btn" id="import-cfg">Import Config</button>
            </div>
            <div class="fx-section"><div class="fx-section-title">UI</div>${togRow('particles',CFG.particles,'Partículas',false)}</div>
            <div class="fx-section"><div class="fx-section-title">Info</div>
                <div style="font-size:10px;color:#555;line-height:1.8;">FATALITY v13.0<br>+ AutoWin / AutoKill (Force Wallbang)<br>FIX: World Color 2ª partida<br>FIX: Third Person 2ª partida</div>
            </div>`
    };

    // ============ MENU ============
    let menuEl=null;
    const menuState={left:12,top:60,minimized:false,tab:'aimbot'};
    let bindingMenuKey=false, lastStatus='menu ready', dragState=null;

    function openMenu(){
        if(menuEl||!introDone)return;
        const menu=document.createElement('div');menu.id='fatality-menu';menu.style.left=menuState.left+'px';menu.style.top=menuState.top+'px';
        if(menuState.minimized)menu.classList.add('minimized');
        menu.innerHTML=`<div class="fx-header"><div style="display:flex;align-items:baseline;"><div class="fx-title">FATALITY</div><div class="fx-version">v13</div></div><div class="fx-header-btns"><div class="fx-hbtn" id="fx-min">&#8722;</div><div class="fx-hbtn fx-close" id="fx-close">&#10005;</div></div></div><div class="fx-body"><div class="fx-sidebar"><div class="fx-tab" data-tab="aimbot">Aimbot</div><div class="fx-tab" data-tab="ragebot">Ragebot</div><div class="fx-tab" data-tab="esp">ESP</div><div class="fx-tab" data-tab="skins">Skins</div><div class="fx-tab" data-tab="misc">Misc</div><div class="fx-tab" data-tab="config">Config</div><div class="fx-status" id="fx-status">status: ${lastStatus}</div></div><div class="fx-content" id="fx-content"></div></div>`;
        document.documentElement.appendChild(menu);menuEl=menu;
        menu.querySelectorAll('.fx-tab').forEach(tab=>{tab.addEventListener('click',()=>switchTab(tab.dataset.tab));});
        menu.querySelector('.fx-header').addEventListener('mousedown',(e)=>{if(e.target.closest('.fx-hbtn'))return;dragState={sx:e.clientX,sy:e.clientY,ox:menu.offsetLeft,oy:menu.offsetTop};});
        document.getElementById('fx-min').addEventListener('click',()=>{menuState.minimized=!menuState.minimized;menu.classList.toggle('minimized',menuState.minimized);});
        document.getElementById('fx-close').addEventListener('click',closeMenu);
        switchTab(menuState.tab);
        requestAnimationFrame(()=>requestAnimationFrame(()=>menu.classList.add('active')));
    }
    function closeMenu(){if(!menuEl)return;document.getElementById('fx-popover')?.classList.remove('open');menuEl.remove();menuEl=null;dragState=null;}
    function toggleMenu(){if(menuEl)closeMenu();else openMenu();}
    function switchTab(tabName){
        if(!menuEl)return;menuState.tab=tabName;
        document.getElementById('fx-popover')?.classList.remove('open');
        menuEl.querySelectorAll('.fx-tab').forEach(t=>t.classList.remove('active'));
        menuEl.querySelector(`[data-tab="${tabName}"]`)?.classList.add('active');
        document.getElementById('fx-content').innerHTML=TAB_CONTENT[tabName]?.()||'';
        attachEvents();
        if(tabName==='skins')initSkinsTab();
    }

    function openPopover(id,gearEl){
        const pop=document.getElementById('fx-popover');pop.classList.remove('skin-pop');
        const m=getFeatureMode(id);
        pop.innerHTML=`<div class="fx-popover-title">Activación</div><div class="fx-radio-group"><button class="fx-radio ${m.mode==='always'?'active':''}" data-pmode="always">Always</button><button class="fx-radio ${m.mode==='hold'?'active':''}" data-pmode="hold">Hold</button><button class="fx-radio ${m.mode==='toggle'?'active':''}" data-pmode="toggle">Toggle</button></div><button class="bind-btn" id="pop-bind">${m.key?keyLabel(m.key):'Asignar tecla'}</button>`;
        const rect=gearEl.getBoundingClientRect();
        pop.style.left=Math.max(8,Math.min(rect.left-100,window.innerWidth-190))+'px';pop.style.top=(rect.bottom+6)+'px';pop.classList.add('open');
        pop.querySelectorAll('[data-pmode]').forEach(btn=>{btn.addEventListener('click',(e)=>{pop.querySelectorAll('[data-pmode]').forEach(b=>b.classList.remove('active'));e.target.classList.add('active');getFeatureMode(id).mode=e.target.dataset.pmode;toggleStates[id]=false;saveCfg();const gear=document.querySelector(`[data-gear="${id}"]`);if(gear)gear.classList.toggle('has-mode',e.target.dataset.pmode!=='always');});});
        document.getElementById('pop-bind').addEventListener('click',(e)=>{const btn=e.target;btn.classList.add('listening');btn.textContent='Presiona algo...';const finish=(code)=>{getFeatureMode(id).key=code;saveCfg();document.removeEventListener('keydown',onKey,true);document.removeEventListener('mousedown',onMouse,true);btn.classList.remove('listening');btn.textContent=keyLabel(code);};const onKey=(ev)=>{ev.preventDefault();ev.stopPropagation();finish(ev.code);};const onMouse=(ev)=>{ev.preventDefault();ev.stopPropagation();finish('Mouse'+ev.button);};document.addEventListener('keydown',onKey,true);document.addEventListener('mousedown',onMouse,true);});
    }
    function openSkinPopover(id,gearEl){
        const pop=document.getElementById('fx-popover'),o=getSkinOpts(id);pop.classList.add('skin-pop');
        pop.innerHTML=`<div class="fx-popover-title">${escHtml(id)}</div><span class="fx-color-label">Wear (0-1)</span><input type="number" id="skin-opt-wear" class="fx-input" min="0" max="1" step="0.001" placeholder="Aleatorio" value="${o.wear!=null?o.wear:''}"><span class="fx-color-label">Seed (0-1000)</span><input type="number" id="skin-opt-seed" class="fx-input" min="0" max="1000" step="1" placeholder="Aleatorio" value="${o.seed!=null?o.seed:''}"><button class="fx-btn" id="skin-opt-reset">Volver a aleatorio</button>`;
        const rect=gearEl.getBoundingClientRect();pop.style.left=Math.max(8,Math.min(rect.left-110,window.innerWidth-235))+'px';pop.style.top=(rect.bottom+6)+'px';pop.classList.add('open');
        const wEl=document.getElementById('skin-opt-wear'),sEl=document.getElementById('skin-opt-seed');
        const save=()=>{const w=wEl.value===''?NaN:Math.min(1,Math.max(0,parseFloat(wEl.value))),s=sEl.value===''?NaN:Math.min(1000,Math.max(0,parseInt(sEl.value,10)));const entry={};if(!isNaN(w))entry.wear=w;if(!isNaN(s))entry.seed=s;if(!CFG.skinOpts)CFG.skinOpts={};if(Object.keys(entry).length)CFG.skinOpts[id]=entry;else delete CFG.skinOpts[id];saveCfg();updateOwnedSkin(id,entry);gearEl.classList.toggle('has-mode',Object.keys(entry).length>0);};
        wEl.addEventListener('input',save);sEl.addEventListener('input',save);
        document.getElementById('skin-opt-reset').addEventListener('click',()=>{wEl.value='';sEl.value='';save();});
    }

    function attachEvents(){
        document.querySelectorAll('.fx-switch input,input[type="checkbox"]').forEach(cb=>{cb.addEventListener('change',(e)=>{CFG[e.target.id]=e.target.checked;saveCfg();
            if(e.target.id==='chams_advanced'&&!e.target.checked)advChamClearAll();
            if(e.target.id==='chams_relative'){const t=document.getElementById('chams-team-colors'),r=document.getElementById('chams-relative-colors');if(t)t.style.display=e.target.checked?'none':'';if(r)r.style.display=e.target.checked?'':'none';}
            if(e.target.id==='vm_tint'&&!e.target.checked)restyleAllVm();
            // Update live indicators
            if(e.target.id==='autowin'){const ind=document.querySelector('.autowin-indicator');if(ind)ind.classList.toggle('on',e.target.checked);}
            if(e.target.id==='autokill'){const ind=document.querySelector('.autokill-indicator');if(ind)ind.classList.toggle('on',e.target.checked);}
        });});
        document.querySelectorAll('.fx-slider').forEach(slider=>{
            slider.addEventListener('input',(e)=>{
                const id=e.target.id,val=parseFloat(e.target.value);CFG[id]=val;
                if(id==='menu_scale')applyMenuScale(val);
                const valEl=document.getElementById(id+'-val');
                if(valEl){
                    if(id==='menu_scale')valEl.textContent=val+'%';
                    else if(['crosshair_alpha','silent_aim_smooth','chams_alpha','chams_emissive','vm_tint_strength','vm_opacity','ragebot_penmargin'].includes(id))valEl.textContent=val.toFixed(2);
                    else if(id==='fog_density')valEl.textContent=val.toFixed(3);
                    else valEl.textContent=Number.isInteger(val)?val:val.toFixed(1);
                }
                saveCfg();
            });
        });
        document.querySelectorAll('.fx-color-input').forEach(ci=>{ci.addEventListener('change',(e)=>{CFG[e.target.id]=e.target.value;if(e.target.id==='menu_color')applyThemeColor(e.target.value);saveCfg();});});
        var xss=document.getElementById('crosshair_style');if(xss)xss.addEventListener('change',(e)=>{CFG.crosshair_style=e.target.value;saveCfg();});
        document.querySelectorAll('[data-target]').forEach(btn=>{btn.addEventListener('click',(e)=>{document.querySelectorAll('[data-target]').forEach(b=>b.classList.remove('active'));e.target.classList.add('active');CFG.aimbot_target=e.target.dataset.target;saveCfg();});});
        document.querySelectorAll('[data-rbone]').forEach(btn=>{btn.addEventListener('click',(e)=>{document.querySelectorAll('[data-rbone]').forEach(b=>b.classList.remove('active'));e.target.classList.add('active');CFG.ragebot_aimbone=e.target.dataset.rbone;saveCfg();});});
        document.querySelectorAll('[data-aamode]').forEach(btn=>{btn.addEventListener('click',(e)=>{document.querySelectorAll('[data-aamode]').forEach(b=>b.classList.remove('active'));e.target.classList.add('active');CFG.antiaim_mode=e.target.dataset.aamode;var cr=document.getElementById('aa-custom-row');if(cr)cr.style.display=CFG.antiaim_mode==='custom'?'block':'none';saveCfg();});});
        document.querySelectorAll('[data-kfxmode]').forEach(btn=>{btn.addEventListener('click',(e)=>{document.querySelectorAll('[data-kfxmode]').forEach(b=>b.classList.remove('active'));e.target.classList.add('active');CFG.killfx_mode=e.target.dataset.kfxmode;saveCfg();setStatus('Kill FX: '+CFG.killfx_mode);});});
        document.querySelectorAll('.fx-gear').forEach(g=>{g.addEventListener('click',(e)=>{e.stopPropagation();openPopover(g.dataset.gear,g);});});
        // NEW BUTTONS
        document.getElementById('autokill-now')?.addEventListener('click',()=>{
            if(!G||!G.player){setStatus('Entra en partida primero');return;}
            const p=G.player,list=G.allEntities?G.allEntities():(G.botMgr&&G.botMgr.bots)||[];
            const def=(G.weapons&&G.weapons.def&&G.weapons.def())||{dmg:36,class:'rifle',hs:4};
            let n=0;
            for(const e of list){if(!e||e===p||!e.alive||e.team===p.team)continue;try{if(typeof G.dealDamage==='function')G.dealDamage(e,9999,p,true,def,'head',0,true);else{e.health=0;e.alive=false;}n++;}catch (_e) {try{e.health=0;e.alive=false;n++;}catch (_e) {}}}
            setStatus('Kill All: '+n+' muertos');
        });
        document.getElementById('win-round-auto')?.addEventListener('click',()=>forceWinNow(null));
        document.getElementById('win-round-t')?.addEventListener('click',()=>forceWinNow('T'));
        document.getElementById('win-round-ct')?.addEventListener('click',()=>forceWinNow('CT'));
        document.getElementById('ambient-force-refresh')?.addEventListener('click',()=>{
            ambientLightCache=null; ambientOrig=null; _ambientG=null;
            setStatus('Luz reseteada - re-aplica');
        });
        document.getElementById('gold-on')?.addEventListener('click',()=>{_goldMode='on';ensureGoldHook();setStatus('Force Gold ON');});
        document.getElementById('gold-once')?.addEventListener('click',()=>{_goldMode='once';ensureGoldHook();setStatus('Force Gold ONCE');});
        document.getElementById('gold-off')?.addEventListener('click',()=>{_goldMode='off';goldRestoreRandom();setStatus('Force Gold OFF');});
        document.getElementById('apply-bot-patch')?.addEventListener('click',()=>applyBotPatch());
        document.getElementById('rage-debug-info')?.addEventListener('click',()=>{if(!G){setStatus('No hay juego');return;}const info=rageGetWeaponInfo();setStatus(`Arma: ${info.id||'?'} | pen: ${info.pen}`);console.log('[rage2]',info);});
        document.getElementById('fun-test-confetti')?.addEventListener('click',()=>{if(G&&G.player)funSpawnConfetti(G.player.x,G.player.y,G.player.z);else{ensureFunCanvas();funSpawnConfetti(0,0,0);}setStatus('Confetti!');});
        document.getElementById('killfx-test')?.addEventListener('click',()=>{if(!G||!G.player){setStatus('Entra en partida');return;}kfxRunFx(G.player.x,G.player.y,G.player.z);setStatus('Kill FX activado!');});
        document.getElementById('menu-key-bind')?.addEventListener('click',(e)=>{const btn=e.currentTarget;btn.classList.add('listening');btn.textContent='Presiona una tecla...';bindingMenuKey=true;const onKey=(ev)=>{ev.preventDefault();ev.stopPropagation();document.removeEventListener('keydown',onKey,true);bindingMenuKey=false;if(ev.code!=='Escape'){CFG.menu_key=ev.code;saveCfg();setStatus('menu key: '+keyLabel(ev.code));}switchTab('config');};document.addEventListener('keydown',onKey,true);});
        document.getElementById('export-cfg')?.addEventListener('click',()=>{const blob=new Blob([JSON.stringify(CFG,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='fatality_v13_config.json';a.click();URL.revokeObjectURL(url);});
        document.getElementById('import-cfg')?.addEventListener('click',()=>{const input=document.createElement('input');input.type='file';input.accept='.json';input.onchange=(e)=>{const file=e.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=(ev)=>{try{const imported=JSON.parse(ev.target.result);Object.assign(CFG,imported);if(!CFG.modes)CFG.modes={};if(!CFG.skinOpts)CFG.skinOpts={};saveCfg();applyThemeColor(CFG.menu_color||'#ffffff');applyMenuScale(CFG.menu_scale);switchTab(menuState.tab);setStatus('Config imported');}catch(err){setStatus('Import failed');}};reader.readAsText(file);};input.click();});
        document.getElementById('give-ingame-money')?.addEventListener('click',()=>{try{const amount=parseInt(document.getElementById('ingame-money-amount')?.value,10)||5000;const P=player();if(!P||!playing()){setStatus('Debes estar en partida');return;}P.money=(P.money||0)+amount;setStatus('+'+amount+' dinero');}catch(e){setStatus('Error');}});
        document.getElementById('give-money')?.addEventListener('click',()=>{try{const amount=parseInt(document.getElementById('money-amount')?.value,10)||16000;const raw=localStorage.getItem('clutcher_inv_v1');if(!raw){setStatus('Open game menu first');return;}const d=JSON.parse(raw);d.coins=(d.coins||0)+amount;localStorage.setItem('clutcher_inv_v1',JSON.stringify(d));setStatus('+'+amount+' coins');}catch(e){setStatus('Error');}});
    }
    function setStatus(msg){lastStatus=msg;const el=document.getElementById('fx-status');if(el)el.textContent='status: '+msg;}

    // ============ HOTKEYS ============
    document.addEventListener('keydown',(e)=>{
        if(bindingMenuKey)return;
        var t=e.target,typing=!!(t&&(t.tagName==='TEXTAREA'||t.isContentEditable||(t.tagName==='INPUT'&&!['range','color','checkbox','button'].includes(t.type))));
        if(e.code===(CFG.menu_key||'Insert')&&!typing&&!e.repeat)toggleMenu();
        if(e.code==='Space')bhopActive=CFG.bhop;
        if(e.code==='KeyV'&&!typing&&!e.repeat&&!bindingMenuKey){CFG.thirdperson=!CFG.thirdperson;saveCfg();}
        if(e.code==='F6'&&!e.repeat){CFG.ragebot_enabled=!CFG.ragebot_enabled;saveCfg();console.log('[rage2]',CFG.ragebot_enabled?'ON':'OFF');}
    });
    document.addEventListener('keyup',(e)=>{if(e.code==='Space')bhopActive=false;});
    document.addEventListener('mousemove',(e)=>{if(!dragState||!menuEl)return;menuState.left=dragState.ox+e.clientX-dragState.sx;menuState.top=dragState.oy+e.clientY-dragState.sy;menuEl.style.left=menuState.left+'px';menuEl.style.top=menuState.top+'px';});
    document.addEventListener('mouseup',()=>{dragState=null;});

    // ============ DOM CREATION ============
    function createUI(){
        const styleEl=document.createElement('style');
        styleEl.textContent=STYLES+`@keyframes reveal{0%{opacity:0;transform:translateX(-40px)}100%{opacity:1;transform:translateX(0)}}@keyframes fall{to{transform:translateY(100vh);opacity:0}}`;
        document.head.appendChild(styleEl);
        applyThemeColor(CFG.menu_color||'#ffffff');applyMenuScale(CFG.menu_scale);
        const intro=document.createElement('div');intro.id='fatality-intro';intro.innerHTML='<div id="fatality-text"></div>';
        const particles=document.createElement('div');particles.id='particles-container';
        const popover=document.createElement('div');popover.id='fx-popover';
        document.documentElement.appendChild(intro);document.documentElement.appendChild(particles);document.documentElement.appendChild(popover);
        document.addEventListener('click',(e)=>{const pop=document.getElementById('fx-popover');if(pop&&pop.classList.contains('open')&&!pop.contains(e.target)&&!e.target.classList.contains('fx-gear')&&!e.target.classList.contains('skin-card-gear'))pop.classList.remove('open');});
    }

    // ============ INIT ============
    window.addEventListener('load',()=>{
        createUI();ensureEsp();ensureDropsEsp();playIntro();
        setTimeout(()=>{setStatus('v13 ready - F6:ragebot | V:3rdperson | Insert:menu');gameLoop();},3500);
    },{once:true});

    window.__FATALITY_CFG = CFG;
    window.__rageSimulateTrail = rageSimulateTrail;
    window.__rageWeapon = rageGetWeaponInfo;
    window.__forceWin = forceWinNow;
    window.__autoKillNow = function () {
        if (!G || !G.player) return;
        var p = G.player;
        var list = G.allEntities ? G.allEntities() : (G.botMgr && G.botMgr.bots) || [];
        var def = (G.weapons && G.weapons.def && G.weapons.def()) || { dmg: 36 };
        var n = 0;
        for (var i = 0; i < list.length; i++) {
            var e = list[i];
            if (!e || e === p || !e.alive || e.team === p.team) continue;
            try {
                G.dealDamage(e, 9999, p, true, def, 'head');
            } catch (err) {
                try { e.health = 0; e.alive = false; } catch (err2) {}
            }
            n++;
        }
        console.log('[autokill] killed', n);
    };
})();
